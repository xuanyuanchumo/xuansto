{
  "name": "sanliu-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:report": "npx ts-node scripts/generate_coverage_report.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report e2e-report",
    "test:e2e:codegen": "playwright codegen http://localhost:5173",
    "coverage:check": "vitest run --coverage --reporter=json --reporter=text",
    "test:performance": "vitest run tests/performance",
    "test:performance:component": "vitest run tests/performance/component-performance.spec.ts",
    "test:performance:memory": "vitest run tests/performance/memory-analysis.spec.ts",
    "test:e2e:performance": "playwright test --config=playwright.performance.config.ts",
    "benchmark": "npm run test:performance && npm run test:e2e:performance"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "axios": "^1.6.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.4.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^1.2.0",
    "@vitest/expect": "^1.2.0",
    "@vue/test-utils": "^2.4.0",
    "happy-dom": "^13.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.2.0",
    "vue-tsc": "^2.0.0"
  }
}
